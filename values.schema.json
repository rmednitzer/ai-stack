{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rmednitzer/ai-stack/blob/main/values.schema.json",
  "title": "ai-stack Helm values",
  "description": "Top-level validation for user-supplied overrides. Covers global settings and each component's `enabled` toggle. Does not enumerate every field in values.yaml — additional properties are allowed everywhere so that in-chart defaults and future additions continue to render. The goal is to catch typos in common override paths, not to replace the inline documentation in values.yaml.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "profile": {
          "type": "string",
          "enum": ["lab", "prod"],
          "description": "Deployment profile. `lab` = single replica, relaxed resources. `prod` = HA, strict resources."
        },
        "namespace": { "type": "string" },
        "imagePullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "storageClass": { "type": "string" },
        "podSecurityStandard": {
          "type": "string",
          "enum": ["privileged", "baseline", "restricted"]
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "gateway": {
          "type": "object",
          "additionalProperties": true,
          "description": "Gateway API defaults for opt-in HTTPRoutes (see per-component `httpRoute`).",
          "properties": {
            "namespace": { "type": "string" }
          }
        },
        "otel": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "endpoint": { "type": "string" },
            "protocol": {
              "type": "string",
              "enum": ["grpc", "http/protobuf", "http/json"],
              "description": "OTLP transport token (OTEL_EXPORTER_OTLP_PROTOCOL). Spec values only; mistyped values silently break telemetry export."
            },
            "insecure": { "type": "boolean" }
          }
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "prometheusRule": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "labels": { "type": "object" },
            "alertPrefix": { "type": "string" },
            "severityLabels": { "type": "object" },
            "rules": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "podHealth":    { "type": "boolean" },
                "availability": { "type": "boolean" },
                "slo":          { "type": "boolean" },
                "security":     { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "externalAPIs": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["name", "baseUrl"],
            "properties": {
              "name": { "type": "string" },
              "baseUrl": { "type": "string", "format": "uri" },
              "apiKey": { "type": "string" },
              "existingSecret": {
                "type": "object",
                "additionalProperties": true,
                "required": ["name", "key"],
                "properties": {
                  "name": { "type": "string" },
                  "key": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "aiGateway": {
      "type": "object",
      "additionalProperties": true,
      "description": "Governed model-egress gateway (Envoy AI Gateway CRs). See docs/components/ai-gateway.md and ADR-006. Mutually exclusive with externalAPIs.",
      "properties": {
        "enabled": { "type": "boolean" },
        "controller": {
          "type": "object",
          "additionalProperties": true,
          "properties": { "image": { "$ref": "#/$defs/image" } }
        },
        "extproc": {
          "type": "object",
          "additionalProperties": true,
          "properties": { "image": { "$ref": "#/$defs/image" } }
        },
        "includeOllama": { "type": "boolean" },
        "ollamaModel": { "type": "string" },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "namespace": { "type": "string" },
              "sectionName": { "type": "string" },
              "port": { "type": "integer" }
            }
          }
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["name", "model", "hostname"],
            "properties": {
              "name": { "type": "string" },
              "schema": { "type": "string" },
              "hostname": { "type": "string" },
              "port": { "type": "integer" },
              "model": { "type": "string" },
              "apiKey": { "type": "string" },
              "existingSecret": {
                "type": "object",
                "additionalProperties": true,
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" }
                }
              }
            }
          }
        },
        "rateLimit": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "limit": { "type": "integer" },
            "unit": { "type": "string", "enum": ["Second", "Minute", "Hour", "Day"] }
          }
        },
        "clientAuth": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "issuer": { "type": "string" },
            "jwksUri": { "type": "string" }
          }
        }
      }
    },
    "authelia":        { "$ref": "#/$defs/component" },
    "openwebui":       { "$ref": "#/$defs/component" },
    "ollama":          { "$ref": "#/$defs/componentWithGpu" },
    "qdrant":          { "$ref": "#/$defs/component" },
    "tika":            { "$ref": "#/$defs/component" },
    "searxng":         { "$ref": "#/$defs/component" },
    "openTerminal":    { "$ref": "#/$defs/component" },
    "mcpo":            { "$ref": "#/$defs/component" },
    "langgraph":       { "$ref": "#/$defs/component" },
    "pydanticai":      { "$ref": "#/$defs/component" },
    "valkey":          { "$ref": "#/$defs/component" },
    "ingestionWorker": { "$ref": "#/$defs/component" },
    "otelCollector":   { "$ref": "#/$defs/component" },
    "postgres": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": {
          "type": "string",
          "enum": ["standalone", "cnpg", "external"],
          "description": "Provisioning mode. See docs/components/postgres.md."
        },
        "database": { "type": "string" },
        "user": { "type": "string" },
        "password": { "type": "string" },
        "tls": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["disable", "prefer", "require", "verify-ca", "verify-full"]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": ["string", "number"] },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$",
          "description": "Optional OCI manifest digest. When set, the template renders repo@digest; when empty, falls back to repo:tag. Per ADR-002."
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": true,
      "description": "Gateway API HTTPRoute (gateway.networking.k8s.io/v1). Opt-in alternative to `ingress`.",
      "properties": {
        "enabled": { "type": "boolean" },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "namespace": { "type": "string" },
              "sectionName": { "type": "string" },
              "port": { "type": "integer" }
            }
          }
        },
        "hostnames": { "type": "array", "items": { "type": "string" } },
        "annotations": { "type": "object" },
        "rules": { "type": "array" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "image": { "$ref": "#/$defs/image" },
        "httpRoute": { "$ref": "#/$defs/httpRoute" }
      }
    },
    "componentWithGpu": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "image": { "$ref": "#/$defs/image" },
        "httpRoute": { "$ref": "#/$defs/httpRoute" },
        "gpu": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "count": { "type": "integer", "minimum": 0 },
            "resourceName": { "type": "string" }
          }
        }
      }
    }
  }
}
