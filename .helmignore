# Patterns to ignore when building packages.
# https://helm.sh/docs/chart_template_guide/helm_ignore_file/

# VCS
.git/
.gitignore
.gitattributes
.editorconfig

# GitHub / CI / CD
.github/
ct.yaml
renovate.json5
.kube-linter.yaml
argocd/
zarf.yaml
Makefile

# Contributor / agent collaboration specs (internal; not for chart consumers)
AGENTS.md
CLAUDE.md
.claude/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# Documentation (not needed in packaged chart)
README.md
HOWTO.md
CONTRIBUTING.md
SECURITY.md
LIMITATIONS.md
CODE_OF_CONDUCT.md
CHANGELOG.md
LICENSE
docs/

# Chart unit tests (helm-unittest; not part of the released chart).
# Anchored to the chart root: a bare `tests/` matches any directory named
# tests at any depth — including templates/tests/, which silently dropped the
# helm-test connection hook from the chart (no Pod rendered for `helm test`).
/tests/

# Supply chain artefacts (distributed separately)
sbom.cdx.json
syft-sbom-output/
grype-reports/

# Build artefacts
zarf-package-*.tar.zst
*.tgz

# Python bytecode (keep files/ingestion-worker packaging clean)
__pycache__/
*.py[cod]

# OS files
.DS_Store
Thumbs.db
