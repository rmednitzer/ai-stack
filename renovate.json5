{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    ":timezone(Europe/Vienna)"
  ],
  "labels": ["dependencies"],
  // Renovate owns ONLY helm-values (values.yaml / values-prod.yaml image
  // tags). GitHub Actions and Dockerfile/container deps are owned by
  // Dependabot (.github/dependabot.yml) — do not re-enable those managers
  // here or both bots will open competing PRs.
  "enabledManagers": ["helm-values"],
  "helm-values": {
    "fileMatch": ["(^|/)values\\.yaml$", "(^|/)values-prod\\.yaml$"]
  },
  "prConcurrentLimit": 8,
  "prHourlyLimit": 2,
  "packageRules": [
    {
      "matchManagers": ["helm-values"],
      "groupName": "helm values image updates",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"]
    }
  ]
}
