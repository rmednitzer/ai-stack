{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    "github>rmednitzer/infra:renovate-preset",
    'config:best-practices',
    ':semanticCommits',
    ':timezone(Europe/Vienna)',
  ],
  labels: [
    'dependencies',
  ],
  reviewers: [
    'rmednitzer',
  ],
  // Single dependency-automation tool for the repo (ADR-010): Renovate owns the
  // helm-values image bumps, GitHub Actions, Dockerfile base images, and the
  // uv-compiled pip locks. Dependabot was retired. Adding a manager here that
  // overlaps a (re-introduced) dependabot.yml would resurrect duplicate PRs, so
  // this `enabledManagers` list is load-bearing — keep it the single source.
  enabledManagers: [
    'helm-values',
    'github-actions',
    'dockerfile',
    'pip-compile',
  ],
  'helm-values': {
    managerFilePatterns: [
      '/(^|/)values\\.yaml$/',
      '/(^|/)values-prod\\.yaml$/',
    ],
  },
  dockerfile: {
    managerFilePatterns: [
      '/(^|/)files/[^/]+/Dockerfile$/',
    ],
  },
  'pip-compile': {
    // The locks carry uv's standard autogenerated header recording the
    // `uv pip compile --universal --generate-hashes` command; Renovate replays
    // it, preserving the universal + fully-hashed invariant (ADR-002, ADR-010).
    // pip-compile updates require `uv` in the Renovate runtime (present in the
    // Mend-hosted app; ensure it on any self-hosted runner).
    managerFilePatterns: [
      '/(^|/)files/[^/]+/requirements\\.txt$/',
    ],
  },
  pinDigests: true,
  prConcurrentLimit: 8,
  prHourlyLimit: 2,
  packageRules: [
    // The `platformAutomerge: false` override that used to sit here is gone
    // (infra BACKLOG F13, closed). It existed because this repository had no
    // requireable status check: every PR-triggered workflow carried a paths
    // filter, so nothing was guaranteed to report, GitHub native auto-merge had
    // nothing to wait on, and it would land helm-values image bumps unattended.
    //
    // Both halves of that are now fixed. `lint.yaml` always runs on pull
    // requests and ends in an aggregate `ci-success` job, and `ci-success` is a
    // required status check on the `main-protection` ruleset (id 15857143,
    // verified 2026-08-13 with bypass_actors still empty). Native auto-merge
    // therefore has a real gate to wait on, so this repository can use the
    // shared preset's `platformAutomerge: true` like the rest of the fleet.
    //
    // If the required check is ever removed from the ruleset, restore this
    // override in the same change.
    {
      matchManagers: [
        'helm-values',
      ],
      groupName: 'helm values image updates',
      matchUpdateTypes: [
        'minor',
        'patch',
        'pin',
        'digest',
      ],
    },
    {
      // Mirrors the retired Dependabot github-actions cadence/grouping: minor +
      // patch + digest grouped, majors kept individual for careful review.
      matchManagers: [
        'github-actions',
      ],
      groupName: 'github-actions minor/patch',
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      schedule: [
        'before 9am on monday',
      ],
      labels: [
        'dependencies',
        'github-actions',
      ],
    },
    {
      matchManagers: [
        'dockerfile',
      ],
      schedule: [
        'before 9am on wednesday',
      ],
      labels: [
        'dependencies',
        'container-images',
      ],
    },
    {
      matchManagers: [
        'pip-compile',
      ],
      schedule: [
        'before 9am on wednesday',
      ],
      labels: [
        'dependencies',
        'python',
      ],
    },
  ],
}
