{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    "github>rmednitzer/infra:renovate-preset",
    'config:best-practices',
    ':semanticCommits',
    ':timezone(Europe/Vienna)',
  ],
  labels: [
    'dependencies',
  ],
  reviewers: [
    'rmednitzer',
  ],
  // Single dependency-automation tool for the repo (ADR-010): Renovate owns the
  // helm-values image bumps, GitHub Actions, Dockerfile base images, and the
  // uv-compiled pip locks. Dependabot was retired. Adding a manager here that
  // overlaps a (re-introduced) dependabot.yml would resurrect duplicate PRs, so
  // this `enabledManagers` list is load-bearing — keep it the single source.
  enabledManagers: [
    'helm-values',
    'github-actions',
    'dockerfile',
    'pip-compile',
  ],
  'helm-values': {
    managerFilePatterns: [
      '/(^|/)values\\.yaml$/',
      '/(^|/)values-prod\\.yaml$/',
    ],
  },
  dockerfile: {
    managerFilePatterns: [
      '/(^|/)files/[^/]+/Dockerfile$/',
    ],
  },
  'pip-compile': {
    // The locks carry uv's standard autogenerated header recording the
    // `uv pip compile --universal --generate-hashes` command; Renovate replays
    // it, preserving the universal + fully-hashed invariant (ADR-002, ADR-010).
    // pip-compile updates require `uv` in the Renovate runtime (present in the
    // Mend-hosted app; ensure it on any self-hosted runner).
    managerFilePatterns: [
      '/(^|/)files/[^/]+/requirements\\.txt$/',
    ],
  },
  pinDigests: true,
  prConcurrentLimit: 8,
  prHourlyLimit: 2,
  packageRules: [
    {
      // Historically this repo had no requireable status check: every
      // PR-triggered workflow (docs.yaml, lint.yaml, sync-image-artifacts.yml)
      // carried a paths filter, so a required check would permanently block PRs
      // that missed those paths, and GitHub native auto-merge had nothing to
      // wait on and would land helm-values image bumps unattended.
      //
      // lint.yaml now always runs on pull requests and ends in an aggregate
      // `ci-success` job precisely so that a required check becomes possible
      // (infra BACKLOG F13). This override nevertheless stays `false` until
      // `ci-success` is actually added to the `main-protection` ruleset
      // (id 15857143). Flipping it before the ruleset is updated would hand
      // merging to native auto-merge while there is still nothing required for
      // it to wait on, which is the exact failure this override exists to
      // prevent. Once the context is required, this rule can be dropped and the
      // preset default (`platformAutomerge: true`) restored.
      "description": "No platform automerge until ci-success is a required check on this repo.",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "platformAutomerge": false
    },
    {
      matchManagers: [
        'helm-values',
      ],
      groupName: 'helm values image updates',
      matchUpdateTypes: [
        'minor',
        'patch',
        'pin',
        'digest',
      ],
    },
    {
      // Mirrors the retired Dependabot github-actions cadence/grouping: minor +
      // patch + digest grouped, majors kept individual for careful review.
      matchManagers: [
        'github-actions',
      ],
      groupName: 'github-actions minor/patch',
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      schedule: [
        'before 9am on monday',
      ],
      labels: [
        'dependencies',
        'github-actions',
      ],
    },
    {
      matchManagers: [
        'dockerfile',
      ],
      schedule: [
        'before 9am on wednesday',
      ],
      labels: [
        'dependencies',
        'container-images',
      ],
    },
    {
      matchManagers: [
        'pip-compile',
      ],
      schedule: [
        'before 9am on wednesday',
      ],
      labels: [
        'dependencies',
        'python',
      ],
    },
  ],
}
